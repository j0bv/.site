      "title": "Net-edge gate",
      "path": "gate-spot-weth-bull-live.sh",
      "content": "#!/usr/bin/env bash\n# Pre-flight gate for chronos_spot_weth_bull_v1 live.\nset -euo pipefail\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/../..\" && pwd)\"\nTHRESHOLDS_ENV=\"${THRESHOLDS_ENV:-$ROOT/strategies/chronos-spot-weth-bull-v1/[path redacted]\"\nHALT_FILE=\"${EXECUTION_HALT_FILE:-$ROOT/[path redacted]\"\nMIN_NATIVE_ETH=\"${SPOT_MIN_NATIVE_ETH:-0.002}\"\nMIN_TOKEN_USD=\"${SPOT_MIN_INVENTORY_USD:-5}\"\nQUOTE_NOTIONAL=\"${SPOT_QUOTE_NOTIONAL_USD:-10}\"\n\nif [[ -f \"$ROOT/[path redacted]\" ]]; then\n  set -a\n  # shellcheck disable=SC1091\n  source \"$ROOT/[path redacted]\"\n  set +a\nfi\n\nRPC_URL=\"${UNISWAP_V3_RPC_URL:-${GMX_RPC_URL:-${GAINS_ARBITRUM_RPC_URL:-}}}\"\nACCOUNT=\"${UNISWAP_V3_ACCOUNT_ADDRESS:-${GMX_ACCOUNT_ADDRESS:-}}\"\nWETH=\"${UNISWAP_V3_WETH:-0x82aF49447D8a07e3bd95BD0d56f35241523fBab1}\"\nUSDC=\"${UNISWAP_V3_USDC:-0xaf88d065e77c8cC2239327C5EDb3A432268e5831}\"\n\nfail=0\n\nfail_check() {\n  echo \"FAIL: [amount redacted]\" >&2\n  fail=1\n}\n\ncheck() {\n  echo \"PASS: [amount redacted]\"\n}\n\nrpc_call() {\n  local method=\"[amount redacted]\"\n  local params=\"[amount redacted]\"\n  curl -sS -X POST \"$RPC_URL\" \\\n    -H 'Content-Type: application/json' \\\n    -d \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":1,\\\"method\\\":\\\"$method\\\",\\\"params\\\":$params}\"\n}\n\nbalance_of() {\n  local token=\"[amount redacted]\"\n  local owner=\"[amount redacted]\"\n  local owner_clean=\"${owner#0x}\"\n  local data=\"0x70a08231000000000000000000000000${owner_clean,,}\"\n  local resp\n  resp=\"$(rpc_call eth_call \"[{\\\"to\\\":\\\"$token\\\",\\\"data\\\":\\\"$data\\\"},\\\"latest\\\"]\")\"\n  local hex\n  hex=\"$(echo \"$resp\" | jq -r '.result // empty')\"\n  if [[ -z \"$hex\" || \"$hex\" == \"null\" ]]; then\n    echo \"0\"\n    return\n  fi\n  python3 - \"$hex\" <<'PY'"
