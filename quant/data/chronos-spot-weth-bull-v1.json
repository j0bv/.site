      "title": "Execution router",
      "path": "execution-router.directional-spot-weth-bull.toml",
      "content": "# signal_mode = \"chronos_spot_weth_bull_v1\"\n# WETH/USDC bull-run scalp: USDC baseline, fast poll, profit-lock to USDC.\n# Load via run-chronos-spot-weth-bull.sh\n\n[execution_router]\nmode = \"dryrun\"\nexecution_enabled = true\nkill_switch = false\nallow_live = false\nwealth_usdc = [redacted]\nmin_delta_usd = 1.0\nmin_delta_mode = \"fractional\"\nmin_delta_frac = 0.02\nper_venue_cap_usd = 10.0\nopen_signal_cap_usd = 10.0\nopen_collateral_cap_usd = 10.0\nmax_concurrent_open_legs = 1\nopen_leg_selection = \"strongest_r_hat\"\nmax_open_fee_frac_of_collateral = 0.20\nmin_liq_distance_bps = 0\nprotective_exit_bypass_reduce_cap = true\nper_venue_reduce_cap_usd = 10.0\nopportunity_rotation_enabled = false\nopportunity_rotation_r_hat_margin = 0.0\nmax_orders_per_venue_per_minute = 12\nrebalance_cooldown_ms = 0\nrebalance_force_threshold_frac = 0.12\ntrailing_stop_enabled = false\ntrailing_stop_frac = 0.05\nrebalance_policy = \"directional_follow\"\ndirectional_r_hat_open = 5.0e-4\ndirectional_r_hat_flip = 5.0e-4\ndirectional_min_hold_ticks = 1\ndirectional_post_flip_cooldown_ticks = 0\ndirectional_close_settle_polls = 3\ndirectional_profit_lock_r = 0.02\ndirectional_profit_flip_relief_r = 0.02\ndirectional_r_collateral_frac = 0.25\ndirectional_disaster_sl_at_open = false\ndirectional_sl_collateral_loss_frac = 0.55\ndirectional_sl_liq_buffer_bps = 40\nallowed_venues = [\"uniswap_v3\"]\nexecution_audit_ndjson_path = \"./[path redacted]\"\nequity_live_enabled = true\nwealth_usdc_cap = [redacted]\n\n[execution_router.gains_market_costs]\nenabled = false\n\n[execution_router.swing_context]\nenabled = false\n\n[execution_router.spot_net_edge]\nenabled = true\nmin_net_edge_usd = 0.0"
    },
