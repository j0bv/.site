# Redis (truth-engine)
REDIS_URL=redis://127.0.0.1:6379

# Neo4j
NEO4J_URI=127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j
NEO4J_ORG_ID=default-org
NEO4J_USER_ID=default-user

# Lightpanda (CDP / browser)
LIGHTPANDA_HOST=127.0.0.1
LIGHTPANDA_PORT=9222
LIGHTPANDA_TIMEOUT=30

# BitNet HTTP (optional; when set, bitnet.rs uses POST /completion for entities/claims/reasoning)
BITNET_URL=http://localhost:8080
# BITNET_MODEL_PATH=/path/to/bitnet/model

# GeoJSON for Location resolution (BitNet agent + Neo4j). Default: geojson. Use D:\ or D:/ for Hampton Roads collection.
GEOJSON_DIR=geojson

# API server (optional)
# API_PORT=3001
